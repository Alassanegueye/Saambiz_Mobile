<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Trafic en clair, pour les builds de DÉVELOPPEMENT uniquement.
         Le manifeste principal le refuse désormais : une application de
         production qui accepte le HTTP laisse un intermédiaire sur le
         réseau lire et modifier les échanges. Mais un poste de
         développement appelle l'API sur http://10.0.2.2 (l'alias de la
         machine hôte vu depuis l'émulateur Android) ou sur une adresse
         locale, sans certificat. `tools:replace` écrase ici la valeur du
         manifeste principal, et nulle part ailleurs. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
