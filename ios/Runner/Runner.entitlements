<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- « Se connecter avec Apple ». À activer aussi sur l'App ID
	     com.saambiz.app (developer.apple.com → Identifiers → Sign In with
	     Apple) ; la signature automatique de Xcode le fait d'elle-même. -->
	<!-- Notifications push (APNs), relayées par Firebase. -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
