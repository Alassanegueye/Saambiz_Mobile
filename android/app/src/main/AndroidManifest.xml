<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- OBLIGATOIRE en release : sans elle, l'app ne peut faire AUCUN appel réseau
         (API, Socket.IO, images Cloudinary) en dehors des builds debug/profile,
         qui héritent cette permission d'un manifeste séparé fourni par Flutter. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ : autorisation d'afficher les notifications push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Position du client, pour lui proposer les boutiques proches.
         Facultative : l'application fonctionne sans, avec les seuls
         centres d'intérêt. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- `usesCleartextTraffic` : le trafic HTTP non chiffré est REFUSÉ.
         Il était autorisé pour tous les builds, vestige du développement
         contre l'émulateur (http://10.0.2.2) : l'application acceptait
         alors des échanges en clair, qu'un intermédiaire sur le réseau
         peut lire et modifier. Les builds de développement le
         réautorisent à eux seuls, voir src/debug/AndroidManifest.xml. -->
    <application
        android:label="SaamBiz"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Canal FCM par défaut (Android 8+) : le même que FcmService et
             que le serveur (push.service.js). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="saambiz_push_channel" />
        <!-- PETITE ICÔNE de la barre d'état.
             Depuis Android 5, le système n'en garde que le CANAL ALPHA : la
             forme est remplie d'une couleur unie, le dessin est perdu.
             `@mipmap/ic_launcher` est un carré plein de marine — il donnait
             donc un carré blanc, le fameux « blob » que tout le monde connaît.
             `ic_launcher_foreground` est le picto sur fond transparent : sa
             silhouette reste le sac SaamBiz, reconnaissable. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_foreground" />
        <!-- Teinte appliquée à cette silhouette et au nom de l'application. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/couleur_notification" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Depuis Android 11 (API 30), une application ne voit plus les autres
             à moins de les déclarer ici. Conséquence directe : `canLaunchUrl`
             répondait TOUJOURS faux, et le bouton « Contacter sur WhatsApp »
             affichait « Vérifiez que l'application est installée » même quand
             WhatsApp l'était. L'API renvoie une adresse https://wa.me/… (voir
             acheteurs.service.js), d'où cette déclaration : les liens web.

             Volontairement minimale. Un filtre large revient à demander la
             liste des applications installées, ce que Google Play fait
             justifier. On ne déclare que ce dont le code a besoin : rien
             n'appelle `canLaunchUrl` sur tel:, mailto: ou sms:. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
