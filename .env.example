# ─── Configuration de l'application mobile ───────────────────────────────────
#
# CE FICHIER EST UN REPLI DE DÉVELOPPEMENT, PAS LA CONFIGURATION DE PRODUCTION.
#
# `pubspec.yaml` déclare `.env` comme asset : il part tel quel dans l'APK, et
# n'importe qui le lit en dézippant le paquet (`unzip app.apk`). Tout ce qu'on
# y met est donc public. N'y mettez jamais de clé.
#
# La configuration réelle passe par `--dart-define`, compilée dans le binaire.
# Depuis la correction de `Env.resoudreApiBaseUrl`, le `--dart-define` l'emporte
# toujours quand il est fourni ; ce fichier ne sert que lorsqu'il ne l'est pas.
# L'ordre était inversé : un build de production compilé avec l'URL HTTPS
# réelle continuait d'appeler l'adresse LAN qui traînait ici.

# ─── API backend SaamBiz ─────────────────────────────────────────────────────
# Émulateur Android   : 10.0.2.2 = localhost de la machine hôte
# Simulateur iOS      : http://localhost:5000/saambiz/v1
# Téléphone physique  : http://<IP-LAN-du-PC>:5000/saambiz/v1
# Flutter Web (Chrome): http://localhost:5000/saambiz/v1
#   En développement, le backend accepte toute origine locale quel que soit
#   son port — Flutter Web en tire un nouveau à chaque lancement.
API_BASE_URL=http://10.0.2.2:5000/saambiz/v1

# Chemins d'authentification (relatifs à API_BASE_URL)
AUTH_LOGIN_PATH=/auth/login
AUTH_REGISTER_PATH=/auth/register

# ─── Lancement en développement ──────────────────────────────────────────────
#
#   flutter run \
#     --dart-define=API_BASE_URL=http://10.0.2.2:5000/saambiz/v1 \
#     --dart-define=ENVIRONNEMENT=dev
#
# ─── Compilation de production ───────────────────────────────────────────────
#
#   flutter build apk --release \
#     --dart-define=API_BASE_URL=https://saambiz-back-uj2z.onrender.com/saambiz/v1 \
#     --dart-define=ENVIRONNEMENT=prod \
#     --dart-define=EMPREINTES_CERTIFICAT=sha256/AAAA…,sha256/BBBB…
#
# `ENVIRONNEMENT=prod` arme les contrôles de `Env.verifier()` : le lancement
# est refusé si l'adresse est en HTTP simple, ou si elle pointe sur localhost,
# sur 10.0.2.2 ou sur une plage privée (192.168.x, 10.x, 172.16-31.x).
# Ces contrôles portent désormais sur l'adresse RÉELLEMENT utilisée.
